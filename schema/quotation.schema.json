{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chi944/quote-distill/schema/quotation.schema.json",
  "title": "Quote Distill supplier quotation",
  "description": "Extraction target for one supplier quotation. Every scalar is a field object that is either stated (with a normalised value and the verbatim source text) or explicitly not_stated. Money and quantities are exact decimal strings, never JSON numbers. Normalisation and arithmetic rules: docs/schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "supplier", "quote_number", "date", "currency", "line_items", "discounts", "gst", "subtotal", "total", "validity", "payment_terms"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "supplier": { "$ref": "#/$defs/textField", "description": "Legal or trading name of the supplier issuing the quotation (not the customer)." },
    "quote_number": { "$ref": "#/$defs/textField", "description": "The supplier's own quotation reference. A customer enquiry or PO reference is not a quote number." },
    "date": { "$ref": "#/$defs/dateField", "description": "Issue date of the quotation." },
    "currency": { "$ref": "#/$defs/currencyField", "description": "Stated only for an ISO code or an unambiguous symbol or name (S$, A$, NZ$, US$, RM, 'Singapore dollars'). A bare '$' is not_stated." },
    "line_items": {
      "type": "array",
      "description": "Every priced row that contributes to the subtotal, in document order, including delivery, labour, free-of-charge and credit rows.",
      "items": { "$ref": "#/$defs/lineItem" }
    },
    "discounts": {
      "type": "array",
      "description": "Unconditional document-level discounts applied after the subtotal and before GST. Conditional discounts (for example early payment) belong in payment_terms, not here.",
      "items": { "$ref": "#/$defs/documentDiscount" }
    },
    "gst": { "$ref": "#/$defs/gst" },
    "subtotal": { "$ref": "#/$defs/moneyField", "description": "Printed sum of line totals, before document discounts and before GST (GST-inclusive when prices are inclusive)." },
    "total": { "$ref": "#/$defs/moneyField", "description": "Printed amount payable." },
    "validity": { "$ref": "#/$defs/validityField" },
    "payment_terms": { "$ref": "#/$defs/textField" }
  },
  "$defs": {
    "notStated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "not_stated" } }
    },
    "raw": {
      "type": "string",
      "minLength": 1,
      "description": "Verbatim substring of the document that supports the value. Required in gold labels; optional in model outputs."
    },
    "textField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "moneyField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$", "description": "Exactly two decimals, no separators or symbols, '-' for credits." },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "unitPriceField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2,4}$", "description": "Two to four decimals; free of charge is 0.00." },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "decimalField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$", "description": "Non-negative, no trailing zeros: '6.5', '24'." },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "dateField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "currencyField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code." },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "unitField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "enum": ["each", "pair", "box", "pack", "set", "sheet", "length", "roll", "bag", "m", "m2", "m3", "kg", "tonne", "l", "hour", "day", "week", "month", "lot"] },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "validityField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "stated" },
            "value": { "type": "string", "pattern": "^(P[1-9][0-9]*D|[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$", "description": "ISO 8601 day duration ('P30D') or an end date ('2026-11-30')." },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "lineDiscountField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "kind", "value"],
          "properties": {
            "state": { "const": "stated" },
            "kind": { "enum": ["percent", "amount"] },
            "value": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "description": "Percent rate ('10') or positive deducted amount with two decimals ('50.00')." },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        { "$ref": "#/$defs/notStated" }
      ]
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "quantity", "unit", "unit_price", "discount", "line_total"],
      "properties": {
        "description": { "$ref": "#/$defs/textField" },
        "quantity": { "$ref": "#/$defs/decimalField" },
        "unit": { "$ref": "#/$defs/unitField" },
        "unit_price": { "$ref": "#/$defs/unitPriceField" },
        "discount": { "$ref": "#/$defs/lineDiscountField" },
        "line_total": { "$ref": "#/$defs/moneyField" }
      }
    },
    "documentDiscount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "kind", "rate", "amount"],
      "properties": {
        "description": { "$ref": "#/$defs/textField" },
        "kind": { "enum": ["percent", "amount"] },
        "rate": { "$ref": "#/$defs/decimalField", "description": "Percent rate for kind 'percent'; not_stated for kind 'amount'." },
        "amount": { "$ref": "#/$defs/moneyField", "description": "Positive amount deducted, as printed." }
      }
    },
    "gst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment", "rate", "amount"],
      "properties": {
        "treatment": {
          "enum": ["exclusive", "inclusive", "not_charged", "not_stated"],
          "description": "exclusive: GST added on top. inclusive: prices already include GST. not_charged: the document says no GST applies. not_stated: GST is not mentioned."
        },
        "rate": { "$ref": "#/$defs/decimalField" },
        "amount": { "$ref": "#/$defs/moneyField" }
      }
    }
  }
}
